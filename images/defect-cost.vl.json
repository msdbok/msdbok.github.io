{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Relative cost of correcting a defect by the stage at which it is found. Each stage is the REPORTED RANGE, drawn as an interval with end dots rather than a bar: the scale is logarithmic, so a bar's length would not be proportional to its value and could not be anchored at zero. The dashed line at 1x is the baseline — the cost of fixing a defect in the phase that introduced it.",
  "background": "transparent",
  "width": 560,
  "height": 250,
  "padding": 6,
  "config": {
    "font": "Tahoma, Verdana, DejaVu Sans, sans-serif",
    "axis": {
      "labelColor": "#282828",
      "titleColor": "#282828",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "domainColor": "#c9cdd1",
      "tickColor": "#c9cdd1"
    },
    "view": {"stroke": null}
  },
  "data": {
    "values": [
      {"stage": "Requirements", "low": 1,  "high": 1,    "label": "1×"},
      {"stage": "Design",       "low": 3,  "high": 6,    "label": "3–6×"},
      {"stage": "Code",         "low": 10, "high": 10,   "label": "10×"},
      {"stage": "Dev. test",    "low": 15, "high": 40,   "label": "15–40×"},
      {"stage": "System test",  "low": 30, "high": 70,   "label": "30–70×"},
      {"stage": "In the field", "low": 40, "high": 1000, "label": "40–1000×"}
    ]
  },
  "encoding": {
    "x": {
      "field": "stage",
      "type": "nominal",
      "sort": null,
      "axis": {
        "title": "Stage at which the defect is found",
        "labelAngle": 0,
        "labelPadding": 8,
        "grid": false
      }
    },
    "y": {
      "field": "low",
      "type": "quantitative",
      "scale": {"type": "log", "domain": [0.8, 1600]},
      "axis": {
        "title": "Relative cost of correction",
        "values": [1, 10, 100, 1000],
        "format": "d",
        "grid": true,
        "gridColor": "#eceff1",
        "gridWidth": 1
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeDash": [4, 4], "strokeWidth": 1, "color": "#9aa0a6"},
      "encoding": {"x": null, "y": {"datum": 1}}
    },
    {
      "mark": {"type": "rule", "strokeWidth": 3, "strokeCap": "round", "color": "#019546"},
      "encoding": {"y2": {"field": "high"}}
    },
    {
      "mark": {"type": "point", "filled": true, "size": 80, "color": "#019546", "stroke": "#ffffff", "strokeWidth": 1.5}
    },
    {
      "mark": {"type": "point", "filled": true, "size": 80, "color": "#019546", "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {"y": {"field": "high", "type": "quantitative"}}
    },
    {
      "mark": {"type": "text", "dy": -14, "fontSize": 12, "fontWeight": "bold", "color": "#282828"},
      "encoding": {
        "y": {"field": "high", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
